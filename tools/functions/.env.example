# tools/functions/.env.example — placeholders only; copy to tools/functions/functions/.env at deploy time.
# (tools/functions/.gitignore ignores the real functions/.env.)
# CVA_STANDALONE=0 makes srv.js export the app instead of listening (Cloud Functions v2 wrapper in index.js).
CVA_STANDALONE=0
SMTP_URL=smtp://your-sender@yourmail.example:APP_PASSWORD_PLACEHOLDER@smtp.gmail.com:587
EMAIL_FROM=Cyber Victim Assistant <your-sender@yourmail.example>

# Optional: live breach provider key. Default breach source is XposedOrNot (free, no key).
HIBP_API_KEY=
