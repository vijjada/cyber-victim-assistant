# tools/backend/.env — placeholders only; never commit the real .env
# Runtime port of the local Express backend (source machine used 8081; 8080 clashed with file share)
PORT=8081

# FedEx-style SMTP relay: scheme smtp://USER:APP_PASSWORD@HOST:PORT  (587 STARTTLS; 465 for SSL)
SMTP_URL=smtp://your-sender@yourmail.example:APP_PASSWORD_PLACEHOLDER@smtp.gmail.com:587
EMAIL_FROM=Cyber Victim Assistant <your-sender@yourmail.example>

# Optional: live breach provider key. Default source is XposedOrNot (free, no key needed);
# set HIBP_API_KEY only if you prefer a HIBP-grade email lookup.
HIBP_API_KEY=
