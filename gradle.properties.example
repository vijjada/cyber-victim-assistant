# ~/.gradle/gradle.properties — placeholders only; copy me to ~/.gradle/gradle.properties and fill in fresh values.
# (Never commit the real gradle.properties — it is gitignored.)

# Google AI Studio key (free tier) → BuildConfig → GeminiClient
GEMINI_API_KEY=

# Backend base URL consumed by ExposureApi:
#   prod:   https://<region>-<project-id>.cloudfunctions.net/cvaExposure
#   laptop: http://<your-LAN-IP>:8081  (+ add the IP to app/src/main/res/xml/network_security_config.xml)
EXPOSURE_BASE_URL=

# Release signing passwords — must match the fresh cva-release.jks you create with keytool (alias cva)
CVA_RELEASE_STORE_PASSWORD=
CVA_RELEASE_KEY_PASSWORD=
